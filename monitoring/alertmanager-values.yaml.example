# monitoring/alertmanager-values.yaml
#
# ⚠️ DO NOT COMMIT THIS FILE — it contains a real SMTP password once filled
# in. Same reasoning as terraform.tfvars and the plain secrets.yaml earlier
# in this project. Add "monitoring/alertmanager-values.yaml" to .gitignore.
# Keep monitoring/alertmanager-values.yaml.example (placeholders only) in git
# instead, so the shape is documented without the real credentials.

alertmanager:
  config:
    global:
      resolve_timeout: 5m
      smtp_smarthost: "smtp.gmail.com:587"
      smtp_from: "your-email@gmail.com"
      smtp_auth_username: "your-email@gmail.com"
      smtp_auth_password: "your-16-char-app-password"
      smtp_require_tls: true

    route:
      receiver: "email-notifications"
      group_by: ["alertname", "namespace"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 3h

    receivers:
      - name: "email-notifications"
        email_configs:
          - to: "your-email@gmail.com"
            send_resolved: true